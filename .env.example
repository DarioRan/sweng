# Copy to .env and edit. Every value has a default in docker-compose.yml,
# so the stack starts without this file (NFR-04).

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=repair
POSTGRES_PASSWORD=repair
POSTGRES_DB=repair
POSTGRES_PORT=5432

# --- Qdrant ------------------------------------------------------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Object store (S3 API, served by SeaweedFS) -------------------------------
S3_ACCESS_KEY=repair
S3_SECRET_KEY=repair-secret
S3_PORT=8333
S3_FILER_PORT=8888
S3_BUCKET_MANUALS=manuals
S3_BUCKET_FIGURES=figures
S3_BUCKET_CAPTURES=captures

# --- Backend -----------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-in-production
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Model layer (NFR-05) ----------------------------------------------------
# hosted | local  — switchable at runtime by the administrator (US-29)
LLM_BACKEND=hosted
LLM_HOSTED_API_KEY=
LLM_LOCAL_URL=http://ollama:11434
LLM_LOCAL_MODEL=llama3.2:3b
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
DETECTOR_WEIGHTS=/models/detector.pt
OLLAMA_PORT=11434

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=5173
