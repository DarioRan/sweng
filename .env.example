# Copy to .env and edit. Every value has a default in docker-compose.yml,
# so the stack starts without this file (NFR-04).

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=repair
POSTGRES_PASSWORD=repair
POSTGRES_DB=repair
POSTGRES_PORT=5432

# --- Qdrant ------------------------------------------------------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_MANUALS=manuals
MINIO_BUCKET_FIGURES=figures
MINIO_BUCKET_CAPTURES=captures

# --- Backend -----------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-in-production
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Model layer (NFR-05) ----------------------------------------------------
# hosted | local  — switchable at runtime by the administrator (US-29)
LLM_BACKEND=hosted
LLM_HOSTED_API_KEY=
LLM_LOCAL_URL=http://ollama:11434
LLM_LOCAL_MODEL=llama3.2:3b
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
DETECTOR_WEIGHTS=/models/detector.pt
OLLAMA_PORT=11434

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=5173
