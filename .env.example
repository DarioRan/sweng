# Copy to .env and edit. Every value has a default in docker-compose.yml,
# so the stack starts without this file (NFR-04).

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=repair
POSTGRES_PASSWORD=repair
POSTGRES_DB=repair
POSTGRES_PORT=5432

# --- Qdrant ------------------------------------------------------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Object store (S3 API, served by SeaweedFS) -------------------------------
S3_ACCESS_KEY=repair
S3_SECRET_KEY=repair-secret
S3_PORT=8333
S3_FILER_PORT=8888
S3_BUCKET_MANUALS=manuals
S3_BUCKET_FIGURES=figures
S3_BUCKET_CAPTURES=captures

# --- Backend -----------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-in-production
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Model layer (NFR-05) ----------------------------------------------------
# local only (ADR 0003): there is no hosted model
LLM_BACKEND=local
LLM_HOSTED_API_KEY=
LLM_LOCAL_URL=http://ollama:11434
LLM_LOCAL_MODEL=qwen3.5:4b
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
# /ask (ADR 0004): what scores a passage against the question ('dense' = the embedder's
# own similarity, or a fastembed cross-encoder), and the score below which /ask abstains
# without calling the model. Recalibrate (app.rag.calibrate) after changing either.
RETRIEVAL_SCORER=dense
RETRIEVAL_CONFIDENCE_THRESHOLD=0.75
DETECTOR_WEIGHTS=/models/detector.onnx
OLLAMA_PORT=11434
OLLAMA_VERSION=0.40.3
# Models compared by `docker compose --profile bench run --rm llm-bench`,
# comma-separated. Empty = the default list in bench/run.py.
BENCH_MODELS=

# --- Where the stores keep their data ------------------------------------------
# Empty = a Docker named volume. A path = a folder on the host, for a machine with a
# small disk quota where only the project folder has room (CREMI). data/ is git-ignored.
# PostgreSQL always uses a named volume: it runs as its own user and cannot write to NFS.
# QDRANT_DATA=./data/volumes/qdrant
# S3_DATA=./data/volumes/s3
# OLLAMA_DATA=./data/volumes/ollama
# MODEL_CACHE=./data/volumes/models

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=5173
